+/// One successful normal-result host operation, retained for PE only.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct PendingPrecision {
+    f: Format,
+    op: Arith,
+    a: [u64; 4],
+    b: [u64; 4],
+    r: [u64; 4],
+    n: usize,
+}
+impl PendingPrecision {
+    pub(crate) fn inexact(&self) -> bool {
+        (0..self.n).any(|i| {
+            let (a, b, r) = (self.a[i], self.b[i], self.r[i]);
+            if self.f == F32 {
+                let (x, y, r) = (
+                    f32::from_bits(a as u32),
+                    f32::from_bits(b as u32),
+                    f32::from_bits(r as u32),
+                );
+                match self.op {
+                    Arith::Add | Arith::Sub => {
+                        let y = if self.op == Arith::Sub { -y } else { y };
+                        let yy = r - x;
+                        (x - (r - yy)) + (y - yy) != 0.0
+                    }
+                    Arith::Mul => f64::from(x) * f64::from(y) != f64::from(r),
+                    Arith::Div => f64::from(r) * f64::from(y) != f64::from(x),
+                    Arith::Sqrt => f64::from(r) * f64::from(r) != f64::from(y),
+                }
+            } else {
+                let (x, y, r) = (f64::from_bits(a), f64::from_bits(b), f64::from_bits(r));
+                match self.op {
+                    Arith::Add | Arith::Sub => {
+                        let y = if self.op == Arith::Sub { -y } else { y };
+                        let yy = r - x;
+                        (x - (r - yy)) + (y - yy) != 0.0
+                    }
+                    Arith::Mul => !exact_product(F64, a, b, self.r[i]),
+                    Arith::Div => !exact_product(F64, self.r[i], b, a),
+                    Arith::Sqrt => !exact_product(F64, self.r[i], self.r[i], b),
+                }
+            }
+        })
+    }
+}
